# Variables de entorno para AVer
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8443
JWT_SECRET=aver_jwt_secret_key_2026_plataforma_academica
JWT_EXPIRES_IN=7d

# Conexión directa a PostgreSQL (pg)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aver_db

# Correo electrónico para verificación y recuperación de contraseña (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
