# Variables de entorno para AVer ("A ver cómo vamos")
# Copia este archivo como .env y completa con tus credenciales reales (nunca subas .env a Git)

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8443

# Clave secreta para firmar tokens JWT (usa una cadena aleatoria larga en producción)
JWT_SECRET=REEMPLAZAR_POR_SECRETO_JWT_SEGURO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=7d

# Conexión directa a PostgreSQL mediante pg (sin ORM)
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/aver_db
# Opcional: forzar SSL ('true' o 'false'). En Render/nube se activa automáticamente si no es localhost.
# DB_SSL=false

# Correo electrónico (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
